# ─────────────────────────────────────────────────────────────────────────
# PARRALAX-AIHFTFUND — environment template
#
# Every secret name lives here with NO VALUE.
# Real values live in operator-private storage (1Password / YubiHSM /
# Cloudflare Worker secrets) and are loaded by the runtime, not committed.
#
# The sanitiser (tools/sanitiser.mjs) refuses any commit that contains a
# pattern resembling a real secret in any file other than this one.
# ─────────────────────────────────────────────────────────────────────────

# ── Identity ────────────────────────────────────────────────────────────
OPERATOR_PRINCIPAL_ID=
COUNCIL_PRINCIPAL_IDS=

# ── Venue: Alpaca paper (Phase T2 first adapter) ────────────────────────
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# ── Venue: OANDA fxTrade Practice (Phase T2) ────────────────────────────
OANDA_PRACTICE_TOKEN=
OANDA_PRACTICE_ACCOUNT=
OANDA_PRACTICE_BASE_URL=https://api-fxpractice.oanda.com

# ── Venue: Binance Spot Testnet (Phase T2) ──────────────────────────────
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=

# ── Venue: Kalshi Sandbox (Phase T2 prediction markets) ─────────────────
KALSHI_SANDBOX_EMAIL=
KALSHI_SANDBOX_PASSWORD=

# ── CHRONO substrate ────────────────────────────────────────────────────
CHRONO_BACKEND=sqlite       # one of: sqlite | d1 | icp-public-gateway
CHRONO_SQLITE_PATH=./chrono.db

# ── Kill switch ─────────────────────────────────────────────────────────
KILL_SWITCH_BACKEND=local   # one of: local | durable-object
DURABLE_OBJECT_NAMESPACE=

# ── Operator hardware-signer (for promotion / reset ceremonies) ─────────
# These are NEVER populated in CI. Operator-machine only.
HARDWARE_SIGNER_TYPE=        # one of: yubikey | ledger | trezor
HARDWARE_SIGNER_DEVICE_ID=
