# ─────────────────────────────────────────────────────────────
# This is a PUBLIC showcase repository.
# Implementation source code lives in private repos.
# ─────────────────────────────────────────────────────────────

# Source implementations — never public
src/
*/src/
**/src/

# Deployment & bootstrap
nova.json
scripts/
deploy/
bootstrap/

# ─── ALLOWLIST: PARRALAX implementation scaffold ───────────────────────
# This directory is a pre-extraction scaffold for the separate
# parralax-aihftfund implementation repository (charter PLAN.md § 5.4
# Option A). The contents are extracted to their own repository via
# `git subtree split` — see parralax-impl/EXTRACTION.md. The allowlist
# entries below let git track the scaffold on this branch so the
# extraction can happen cleanly.
!parralax-impl/
!parralax-impl/src/
!parralax-impl/src/**
!parralax-impl/scripts/
!parralax-impl/scripts/**
!parralax-impl/tests/
!parralax-impl/tests/**
!parralax-impl/tools/
!parralax-impl/tools/**
!parralax-impl/charters/
!parralax-impl/charters/**
!parralax-impl/.github/
!parralax-impl/.github/**

# Strategy registers & manifests
*.csv
*_Register.csv
*_Manifest.json
SDK_Model_Manifest.json

# Extensions and protocols (full implementations)
extensions/
protocols/

# Private SDK modules
sdk/ai-model-engines/
sdk/sovereign-field-models/
sdk/frontend-intelligence-models/

# Environment and secrets
.env
.env.*
*.key
*.pem
secrets/

# Node
node_modules/
build/
.cache/

# Ignore dist directories except root dist/ (Cloudflare Pages assets)
**/dist/
!dist/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
